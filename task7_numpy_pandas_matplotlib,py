import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

# b. NumPy 1D array
arr = np.arange(1, 11)
print("Mean:", arr.mean(), "Sum:", arr.sum())
reshaped = arr.reshape(2, 5)
print(reshaped)

# c. Element-wise arithmetic
a = np.array([1, 2, 3])
b = np.array([4, 5, 6])
print(a + b, a - b, a * b, a / b)

# d. Pandas DataFrame
data = {
    "Name": ["Ann", "Bob", "Cate", "Dan", "Eve"],
    "Marks": [45, 67, 89, 30, 72],
    "Age": [20, 21, 22, 20, 23],
    "Course": ["IT", "CS", "IT", "CS", "IT"]
}
df = pd.DataFrame(data)
print(df)

# e. Filter marks > 50
print(df[df["Marks"] > 50])

# f. Bar chart
plt.bar(df["Name"], df["Marks"])
plt.title("Students vs Marks")
plt.xlabel("Name")
plt.ylabel("Marks")
plt.savefig("bar_chart.png")
plt.close()

# g. Line graph saved as png
plt.plot(df["Name"], df["Marks"], marker="o")
plt.title("Marks Trend")
plt.xlabel("Name")
plt.ylabel("Marks")
plt.savefig("line_chart.png")
plt.close()